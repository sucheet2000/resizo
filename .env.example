# Copy this file to configure Resizo's environment.
#   Local dev (Next.js auto-loads this file):  cp .env.example .env.local
#   Docker Compose (env_file: .env):            cp .env.example .env
#
# Every route needs the full set — resize/compress/convert/crop/heic and
# auth/signin construct an Upstash rate limiter at request time, and
# app/api/account/delete uses the Supabase service role key. A missing var
# fails that route at runtime, not at build time.

# Public — safe to expose to the browser, read by the Supabase client SDK.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
