# Copy this file to configure Resizo's environment.
#   Local dev (Next.js auto-loads this file):  cp .env.example .env.local
#   Docker Compose (env_file: .env):            cp .env.example .env
#
# Resizo is a stateless tool: no accounts, no database. The image tools
# (resize/compress/convert/crop/heic) construct an Upstash rate limiter at
# request time, so a missing Upstash var fails that route at runtime, not at
# build time. Everything else below is optional.

# Rate limiting — server-only, never sent to the browser.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Optional — Sentry error tracking. Leave both unset and error tracking is a
# clean no-op (nothing initialises, build and tests are unaffected). Set them to
# turn it on: SENTRY_DSN is used server + edge side, NEXT_PUBLIC_SENTRY_DSN in
# the browser. Use the same project DSN for both. (SENTRY_AUTH_TOKEN, used only
# to upload source maps at build, is set in the Vercel/CI dashboard, never here.)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Optional — Vercel Blob, for direct-to-Blob uploads (files too large for the
# platform's 4.5 MB request-body limit bypass the API route body entirely: the
# browser uploads straight to Blob, then the API route fetches by URL). Leave
# unset and /api/blob/upload cleanly returns 503, and every tool falls back to
# posting the file directly (fine up to ~4.5 MB). Provisioned per-project from
# the Vercel dashboard's Storage tab — there is no local/self-hosted equivalent,
# so the Docker path always uses the direct-upload fallback.
BLOB_READ_WRITE_TOKEN=
